+  ssize_t count = ok ? recv(fd,response,sizeof(response)-1,0) : -1;
+  close(fd);
+  if (count <= 8 || std::strncmp(response,"NGD12_OK ",9)!=0) return false;
+  response[count] = 0;
+  return ngd::ParseDeadline(response+9,deadline) && *deadline>0;
+#else
+  (void)admit;
+  return false;
+#endif
