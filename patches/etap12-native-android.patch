+  bool ok=connect(fd,reinterpret_cast<sockaddr*>(&addr),offsetof(sockaddr_un,sun_path)+1+n)==0;
+  struct ucred peer={};socklen_t len=sizeof(peer);ok=ok&&getsockopt(fd,SOL_SOCKET,SO_PEERCRED,&peer,&len)==0&&peer.uid==0;
