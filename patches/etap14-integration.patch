+bool DataSnapshot::Capture(){nodes_.clear();captured_=false;for(const auto& path:roots_)if(!Walk(path,&nodes_,true))return false;captured_=true;return true;}
+bool DataSnapshot::SaveExclusive(const char* path) const {
