+ while((e=readdir(dir))) {
+  if(!strcmp(e->d_name,".")||!strcmp(e->d_name,".."))continue;
+  if(!TrustedTree(path+"/"+e->d_name)){ok=false;break;}
+ }
+ closedir(dir);return ok;
